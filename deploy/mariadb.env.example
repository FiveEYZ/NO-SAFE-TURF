# LEGACY PYTHON REFERENCE ONLY: v0.2 uses mariadb.example.json.
# Set these in the storage service process environment; never in client convars.
NST_BACKEND=mariadb
NST_DB_HOST=127.0.0.1
NST_DB_PORT=3306
NST_DB_NAME=no_safe_turf
NST_DB_USER=nst_runtime
NST_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
NST_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Optional: CA file for verified TLS (hostname must match the certificate).
# NST_DB_SSL_CA=C:/private/mariadb-ca.pem
# This file documents variables; service.server does not automatically load .env files.

